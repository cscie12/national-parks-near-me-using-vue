# Copy this file to .env and put your own key in.
# Get a free key at https://www.nps.gov/subjects/developer/get-started.htm
# DEMO_KEY works for testing but is heavily rate-limited.
#
# NOTE: Vite only exposes variables that start with VITE_ to browser code.
# That prefix is a warning: anything VITE_ ends up PUBLIC in the JavaScript bundle.
VITE_NPS_API_KEY=DEMO_KEY
